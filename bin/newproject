#!/usr/bin/env bash
# Create a new research entry in _projects/ with front matter already filled in.
#   ./bin/newproject "Neural Decoding of Reach Intent"
set -euo pipefail

if [ $# -lt 1 ]; then
  echo "usage: $0 \"Project Title\"" >&2
  exit 1
fi

title="$1"
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

slug="$(printf '%s' "$title" \
  | tr '[:upper:]' '[:lower:]' \
  | sed -e 's/[^a-z0-9]/-/g' -e 's/--*/-/g' -e 's/^-//' -e 's/-$//')"

if [ -z "$slug" ]; then
  echo "error: title produced an empty slug" >&2
  exit 1
fi

file="$root/_projects/$slug.md"

if [ -e "$file" ]; then
  echo "error: $file already exists" >&2
  exit 1
fi

mkdir -p "$root/_projects"
# Place the new project last: highest existing order + 10 (projects are
# numbered in tens so others can be slotted in between).
max_order=$(cat "$root"/_projects/*.md 2>/dev/null \
  | sed -n -E 's/^order:[[:space:]]*([0-9]+)[[:space:]]*$/\1/p' \
  | sort -n | tail -1)
next_order=$(( ${max_order:-0} + 10 ))

cat > "$file" <<EOF
---
title: "$title"
order: $next_order
# pi: "Prof. Jane Doe"                  # optional, "Lab of …" under the title
# pi_url: "https://example.org/doe-lab"  # optional, links the PI's name
# organisation: "University of Somewhere"
description: "One or two sentences — the teaser shown on the Research card."
thumbnail: /assets/img/thumb-1.svg
# post: the-slug-of-a-post-in-_posts   # optional, adds a "Blog Post" link
# links:
#   publication: "https://doi.org/..."
#   github: "https://github.com/rythdg/..."
---
EOF

echo "$file"
